# PostgreSQL used by Docker Compose
POSTGRES_DB=hackops_dev
POSTGRES_USER=hackops
POSTGRES_PASSWORD=change-me-for-non-local-use
POSTGRES_PORT=5432

# FastAPI
APP_NAME=HackOps API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://hackops:change-me-for-non-local-use@db:5432/hackops_dev
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Authentication is implemented in a later vertical slice. This value is
# included now so every environment has an explicit secret boundary.
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
